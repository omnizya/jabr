{
	"name": "@omnizya/jabr",
	"description": "ACP + A2A + MCP multi-agent experiment — Hermes + OpenCode stack",
	"version": "0.4.0-pre-alpha",
	"module": "index.ts",
	"type": "module",
	"private": true,
	"license": "MIT",
	"author": {
		"name": "Mohamed Moughamir",
		"url": "https://moughamir.github.io",
		"email": "moughamir@gmail.com"
	},
	"repository": {
		"url": "github.com/omnizya/jabr"
	},
	"scripts": {
		"orchestrator": "bun src/runtime/orchestrator.ts",
		"oracle": "bun src/runtime/agents/oracle.ts",
		"librarian": "bun src/runtime/agents/librarian.ts",
		"explorer": "bun src/runtime/agents/explorer.ts",
		"designer": "bun src/runtime/agents/designer.ts",
		"fixer": "bun src/runtime/agents/fixer.ts",
		"jarvis": "bun src/runtime/agents/jarvis.ts",
		"mcp": "bun src/protocols/mcp/server/tools.ts",
		"acp-bridge": "bun src/runtime/acp-bridge.ts",
		"demo": "bun run --parallel scripts/demo.ts",
		"scientist": "bun src/runtime/agents/scientist.ts",
		"verification": "bun src/runtime/agents/verification.ts",
		"dev": "bash scripts/dev.sh",
		"cli": "bun scripts/jabr-cli.ts",
		"build": "bun scripts/build.ts",
		"test:e2e": "bun test tests/e2e-live.test.ts",
		"typecheck": "bun run tsc --noEmit",
		"types": "tsc --noEmit",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"validate": "tsc --noEmit && biome lint .",
		"kb-maintenance": "bun scripts/kb-maintenance.ts",
		"fetch:sources": "bun scripts/opensrc-fetch.ts",
		"souls": "python3 scripts/generate-agent-souls.py",
		"prepare": "husky"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.12",
		"@types/bun": "^1.4.2",
		"husky": "^9.1.7",
		"lint-staged": "^17.5.0",
		"repomix": "^1.18.0"
	},
	"peerDependencies": {
		"typescript": "^7.0.2"
	},
	"dependencies": {
		"@a2a-js/sdk": "^1.1.0",
		"@faker-js/faker": "^10.6.0",
		"@huggingface/transformers": "^4.2.0",
		"@modelcontextprotocol/sdk": "^1.30.0",
		"@tensorflow/tfjs-node": "^4.22.0",
		"ai": "^7.0.97",
		"brain.js": "^2.0.0-beta.24",
		"gun": "^0.2020.1241",
		"headroom-ai": "^0.37.0",
		"tar": "^7.5.22",
		"zod": "^4.6.0"
	},
	"trustedDependencies": [
		"@tensorflow/tfjs-node",
		"core-js",
		"gl",
		"onnxruntime-node",
		"protobufjs",
		"sharp"
	]
}
