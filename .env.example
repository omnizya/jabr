# 9Router gateway (used by LLM, Search, and ImageGen adapters)
NINEROUTER_URL=http://127.0.0.1:20128
NINEROUTER_KEY=«redacted:sk-…»
NINEROUTER_MODEL=openrouter/minimax/minimax-m3:free

# Jabr orchestrator endpoint — REQUIRED for all agents
# Must be a valid http:// or https:// URL with a host.
# JABR_URL takes precedence; ORCHESTRATOR_URL is accepted as legacy fallback.
JABR_URL=http://localhost:4000

# Vercel AI Gateway (optional LLM provider — MiniMax M3/M2.7 free via GMI Cloud through Sept 6, 2026)
# Set JABR_LLM_PROVIDER=vercel OR provide VERCEL_AI_GATEWAY_KEY to select this adapter.
# Default model uses the resilient form (standard ID + gateway order ['gmicloud']) so it
# keeps working after the free period ends (falls back to other providers, billed at rate).
JABR_LLM_PROVIDER=
VERCEL_AI_GATEWAY_KEY=
VERCEL_AI_GATEWAY_MODEL=minimax/minimax-m3
# VERCEL_AI_GATEWAY_BASE_URL=

# Orchestrator auth — JSON array of {key, description, allowedAgents, enabled}
# Empty allowedAgents = wildcard (all agents). A2A_AUTH_TOKEN is used as fallback.
A2A_API_KEYS=[{"key":"your-key-here","description":"dev","allowedAgents":[],"enabled":true}]
A2A_AUTH_TOKEN=
