# =============================================================================
# Jabr — Comprehensive Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values. All variables have sensible
# dev defaults documented inline. Variables marked [REQUIRED] must be set.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. ORCHESTRATOR & CORE INFRASTRUCTURE
# -----------------------------------------------------------------------------

# [REQUIRED] Jabr orchestrator endpoint — must be a valid http(s) URL with host.
# JABR_URL takes precedence; ORCHESTRATOR_URL is the legacy fallback.
JABR_URL=http://localhost:4000
# ORCHESTRATOR_URL=http://localhost:4000

# Port every agent and infrastructure process binds to.
# Defaults match src/constants/ecosystem.ts — override only to avoid collisions.
ORCHESTRATOR_PORT=4000
ORACLE_PORT=4001
LIBRARIAN_PORT=4002
EXPLORER_PORT=4003
DESIGNER_PORT=4004
FIXER_PORT=4005
SCIENTIST_PORT=4006
GITHUB_WEBHOOK_PORT=4007
JABR_REALTIME_PORT=4008
VERIFICATION_PORT=4009
JARVIS_PORT=1337

# Directory for SQLite memory databases (jabr.db, jabr-bridge.db).
# Defaults to <cwd>/memory when unset.
# JABR_MEMORY_DIR=./memory

# Node environment — controls x402 chain verification (production disables it).
NODE_ENV=development

# -----------------------------------------------------------------------------
# 2. LLM PROVIDERS
# -----------------------------------------------------------------------------
# Three provider backends are supported. Selection priority:
#   1. JABR_LLM_PROVIDER=openai   → generic OpenAI-compatible adapter
#   2. JABR_LLM_PROVIDER=vercel OR VERCEL_AI_GATEWAY_KEY set → Vercel AI Gateway
#   3. Otherwise → 9Router (default, free models via OpenRouter)

# --- Provider selector ---
# JABR_LLM_PROVIDER=            # "openai" | "vercel" | unset (9Router)
# JABR_LLM_PROVIDER=vercel

# --- 9Router (default LLM gateway: OpenAI-compatible, free via OpenRouter) ---
NINEROUTER_URL=http://127.0.0.1:20128
# NINEROUTER_KEY=               # [REQUIRED for 9Router] Your API key
NINEROUTER_MODEL=openrouter/minimax/minimax-m3:free

# --- Vercel AI Gateway (optional — MiniMax M3/M2.7 free via GMI Cloud) ---
# Set JABR_LLM_PROVIDER=vercel OR provide VERCEL_AI_GATEWAY_KEY to activate.
# VERCEL_AI_GATEWAY_KEY=        # [REQUIRED for Vercel] Your gateway API key
VERCEL_AI_GATEWAY_MODEL=minimax/minimax-m3
# VERCEL_AI_GATEWAY_BASE_URL=   # Override gateway base URL (rarely needed)

# --- Generic OpenAI-compatible provider (any /chat/completions endpoint) ---
# Activated by JABR_LLM_PROVIDER=openai.
# JABR_OPENAI_API_KEY=          # [REQUIRED for OpenAI] Your API key
# JABR_OPENAI_BASE_URL=         # Override base URL (default: https://api.openai.com/v1)
# JABR_OPENAI_MODEL=            # Override model ID (default: gpt-4o)

# -----------------------------------------------------------------------------
# 3. A2A AUTHENTICATION
# -----------------------------------------------------------------------------
# API keys are loaded as a JSON array. Each entry: {key, description, allowedAgents, enabled}
# allowedAgents: [] = wildcard (all agents). A2A_AUTH_TOKEN is a legacy single-token fallback.
# A2A_API_KEYS=[{"key":"your-key-here","description":"dev","allowedAgents":[],"enabled":true}]
# A2A_AUTH_TOKEN=

# When "true", requests without a valid API key are rejected.
A2A_REQUIRE_AUTH=false

# -----------------------------------------------------------------------------
# 4. TOKEN BUDGETS
# -----------------------------------------------------------------------------
# Per-agent token cap (total tokens consumed before the agent stops).
# Default: 100,000 tokens per agent when unset.
# JABR_TOKEN_CAP_ORACLE=100000
# JABR_TOKEN_CAP_LIBRARIAN=100000
# JABR_TOKEN_CAP_EXPLORER=100000
# JABR_TOKEN_CAP_DESIGNER=100000
# JABR_TOKEN_CAP_FIXER=100000
# JABR_TOKEN_CAP_JARVIS=100000
# JABR_TOKEN_CAP_SCIENTIST=100000

# -----------------------------------------------------------------------------
# 5. RATE LIMITING & IDEMPOTENCY
# -----------------------------------------------------------------------------
# Sliding-window rate limiter (per-caller). Defaults: 60 requests / 60s window.
# JABR_RATE_LIMIT_WINDOW_MS=60000
# JABR_RATE_LIMIT_MAX_REQUESTS=60

# Webhook idempotency lock TTL (default: 24h in milliseconds).
# Prevents duplicate webhook processing for the same event ID.
# JABR_WEBHOOK_IDEMPOTENCY_TTL_MS=86400000

# -----------------------------------------------------------------------------
# 6. x402 SETTLEMENT & PAYMENTS
# -----------------------------------------------------------------------------
# [REQUIRED for orchestrator] HMAC secret for signing x402 payment tokens.
# Generate with: openssl rand -hex 32
# Without it, the orchestrator refuses to start (tokens would be forgeable).
# JABR_X402_HMAC_SECRET=

# Blockchain RPC endpoint for chain verification (optional, disabled in production).
# JABR_X402_CHAIN_ENDPOINT=

# Auto-refill thresholds for agent Pollen balances.
# JABR_X402_AUTO_REFILL_THRESHOLD=0
# JABR_X402_AUTO_REFILL_AMOUNT=0

# Default currency for settlement tokens (e.g., "POLLEN", "USDC").
# JABR_X402_CURRENCY=

# Enable on-chain verification outside production ("1" to enable, unset = disabled).
# JABR_X402_CHAIN_VERIFICATION_ENABLED=

# -----------------------------------------------------------------------------
# 7. GITHUB WEBHOOK
# -----------------------------------------------------------------------------
# Secret shared with GitHub for HMAC-SHA256 signature verification (x-hub-signature-256).
GITHUB_WEBHOOK_SECRET=change-me

# GitHub Personal Access Token for webhook-triggered actions (labels, comments, etc.).
# GITHUB_TOKEN=

# Default repo (owner/name) for webhook-driven operations.
GITHUB_REPO=omnizya/jabr

# Override the URL GitHub dispatches webhooks to (defaults to orchestrator endpoint).
# GITHUB_WEBHOOK_DELEGATE_URL=

# -----------------------------------------------------------------------------
# 8. POLLINATIONS (IMAGE/AUDIO GENERATION)
# -----------------------------------------------------------------------------
# API key for Pollinations (sk_... or pk_...). Used by x402 settlement and the designer agent.
# POLLINATIONS_API_KEY=

# -----------------------------------------------------------------------------
# 9. CORS
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins. Empty = dev default allowlist
# (localhost:5173, 8080, 4000-4006, 1337).
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# -----------------------------------------------------------------------------
# 10. HERMES KANBAN INTEGRATION
# -----------------------------------------------------------------------------
# Board ID and task ID for syncing Jabr tasks to Hermes kanban.
# HERMES_KANBAN_BOARD=
# HERMES_KANBAN_TASK=
