{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama-cloud/gemma4:31b",
  "env": {
    "NINEROUTER_URL": "http://localhost:20127",
    "NINEROUTER_KEY": "sk-your-key-here"
  },
  "agents": {
    "orchestrator": {
      "mode": "primary",
      "skills": [
        "deepwork",
        "verification-planning",
        "reflect",
        "worktrees",
        "codemap"
      ]
    },
    "oracle": {
      "mode": "subagent",
      "skills": [
        "simplify"
      ]
    },
    "librarian": {
      "mode": "subagent",
      "skills": []
    },
    "explorer": {
      "mode": "subagent",
      "skills": [
        "codemap"
      ]
    },
    "designer": {
      "mode": "subagent",
      "skills": []
    },
    "fixer": {
      "mode": "subagent",
      "skills": []
    }
  },
  "mcp": {
    "servers": {
      "jabr-tools": {
        "type": "local",
        "command": [
          "bun",
          "mcp-servers/tools.ts"
        ]
      }
    }
  }
}
